---
interface Props {
  name: string;
}
const { name } = Astro.props;

// Simple stroke icons, one per editing category (keyed by `icon` in site.json).
const paths: Record<string, string> = {
  podcast: `<rect x="9" y="2.5" width="6" height="11" rx="3"/><path d="M5.5 11a6.5 6.5 0 0 0 13 0"/><path d="M12 17.5V21"/><path d="M8.5 21h7"/>`,
  story: `<path d="M12 6.2C10 4.8 7.4 4.2 4 4.2v13.6c3.4 0 6 .6 8 2 2-1.4 4.6-2 8-2V4.2c-3.4 0-6 .6-8 2z"/><path d="M12 6.2v13.6"/>`,
  ads: `<path d="M20 4 6 9H4a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2h2l14 5V4z"/><path d="M7 15v5h3v-4"/>`,
  social: `<rect x="7" y="2" width="10" height="20" rx="2.5"/><path d="M10.5 9.5l4 2.5-4 2.5z"/><path d="M11 19h2"/>`,
  documentary: `<rect x="2" y="7" width="13" height="11" rx="2"/><path d="M15 11l7-3.5v10L15 14"/><circle cx="6.5" cy="4" r="2"/><circle cx="11.5" cy="4" r="2"/>`,
  motion: `<path d="M4 18C9 18 15 6 20 6"/><circle cx="4" cy="18" r="2.2"/><circle cx="20" cy="6" r="2.2"/><path d="M13 18h7"/>`,
};
const d = paths[name] ?? paths.story;
---

<svg
  class="cat-card__icon"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={d}
/>
